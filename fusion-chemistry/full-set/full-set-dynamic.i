#Testing implementation of simple fusion reactions at the pedestal
#Assumptions:
# temperature = 0.5 keV

#Constant electrion and ion species temperatures in eV
Te = '500'
Ti = '500'

[GlobalParams]
  potential_units = V
  use_moles = true
[]

[Mesh]
  #Sets up a 0D mesh with 1 element
  [geo]
    type = GeneratedMeshGenerator
    nx = 1
    dim = 1
  []
[]

#Defines the problem type, such as FE, eigen value problem, etc.
[Problem]
  type = FEProblem
[]

#User defined name for the variables.
#Other variable properties are defined here,
# such as family of shape function and variable order
# (the default family/order is Lagrange/First)
[Variables]
  #Main species in log-molar
  [Dp]
  []
  [em]
  []
  [D]
  []
  #[D2]
  #[]
  [D2p]
  []
  [Tp]
  []
[]

[AuxVariables]
  #Converted densities
  [Dp_density]
    order = CONSTANT
    family = MONOMIAL
  []
  [em_density]
    order = CONSTANT
    family = MONOMIAL
  []
  [D_density]
    order = CONSTANT
    family = MONOMIAL
  []
  [D2_density]
    order = CONSTANT
    family = MONOMIAL
  []
  [D2p_density]
    order = CONSTANT
    family = MONOMIAL
  []
  [Tp_density]
    order = CONSTANT
    family = MONOMIAL
  []

  #D2 background gas in log-molar
  [D2]
  []

  #Reaction rate coefficients
  [kEI1]
    order = CONSTANT
    family = MONOMIAL
  []
  [kEI2]
    order = CONSTANT
    family = MONOMIAL
  []
  [kEI3]
    order = CONSTANT
    family = MONOMIAL
  []
  [kRC]
    order = CONSTANT
    family = MONOMIAL
  []
  [kDS1]
    order = CONSTANT
    family = MONOMIAL
  []
  [kDS2]
    order = CONSTANT
    family = MONOMIAL
  []
  [kDS3]
    order = CONSTANT
    family = MONOMIAL
  []
  [kDS4]
    order = CONSTANT
    family = MONOMIAL
  []
  [kFS1]
    order = CONSTANT
    family = MONOMIAL
  []

  #Reaction rates
  [REI1]
    order = CONSTANT
    family = MONOMIAL
  []
  [REI2]
    order = CONSTANT
    family = MONOMIAL
  []
  [REI3]
    order = CONSTANT
    family = MONOMIAL
  []
  [RDS1]
    order = CONSTANT
    family = MONOMIAL
  []
  [RDS2]
    order = CONSTANT
    family = MONOMIAL
  []
  [RDS3]
    order = CONSTANT
    family = MONOMIAL
  []
  [RDS4]
    order = CONSTANT
    family = MONOMIAL
  []
  [RRC]
    order = CONSTANT
    family = MONOMIAL
  []
  [RFS1]
    order = CONSTANT
    family = MONOMIAL
  []

  #Source terms
  [SDp]
    order = CONSTANT
    family = MONOMIAL
  []
  [Sem]
    order = CONSTANT
    family = MONOMIAL
  []
  [SD]
    order = CONSTANT
    family = MONOMIAL
  []
  [SD2p]
    order = CONSTANT
    family = MONOMIAL
  []
  [SD2]
    order = CONSTANT
    family = MONOMIAL
  []
[]

[Kernels]
  #Adds the time derivative for the variables (for CRANE)
  [dDp_dt]
    type = TimeDerivative
    variable = Dp
  []
  [dem_dt]
    type = TimeDerivative
    variable = em
  []
  [dD_dt]
    type = TimeDerivative
    variable = D
  []
  #[dD2_dt]
  #  type = TimeDerivative
  #  variable = D2
  #[]
  [dD2p_dt]
    type = TimeDerivative
    variable = D2p
  []
  [dTp_dt]
    type = TimeDerivative
    variable = Tp
  []
[]

[AuxKernels]
  #Conversion out of log-molar
  [Dp_density_aux]
    type = DensityMoles
    variable = Dp_density
    density_log = Dp
    execute_on = 'LINEAR TIMESTEP_END'
  []
  [em_density_aux]
    type = DensityMoles
    variable = em_density
    density_log = em
    execute_on = 'LINEAR TIMESTEP_END'
  []
  [D_density_aux]
    type = DensityMoles
    variable = D_density
    density_log = D
    execute_on = 'LINEAR TIMESTEP_END'
  []
  #[D2_density_aux]
  #  type = DensityMoles
  #  variable = D2_density
  #  density_log = D2
  #  execute_on = 'LINEAR TIMESTEP_END'
  #[]
  [D2p_density_aux]
    type = DensityMoles
    variable = D2p_density
    density_log = D2p
    execute_on = 'LINEAR TIMESTEP_END'
  []
  [Tp_density_aux]
    type = DensityMoles
    variable = Tp_density
    density_log = Tp
    execute_on = 'LINEAR TIMESTEP_END'
  []

  #Molecular neutral density for background gas case (for plotting, NOT calculations)
  [D2_density_aux]
    type = ConstantAux
    variable = D2_density
    value = 5e+12
  []

  #Constant molecular neutral density for calculations
  [D2_val]
    type = ConstantAux
    variable = D2

    #1e+14 in log-molar
    #value = -22.518685267

    #1e+13 in log-molar
    #value = -24.82127036

    #5e+12 in log-molar
    #value = -25.5144175406

    #4e+12 in log-molar
    value = -25.7375610919

    #3e+12 in log-molar
    #value = -26.0252431643

    #1e+12 in log-molar
    #value = -27.123855453

    #1e+11 in log-molar
    #value = -29.426440546

    #1e+10 in log-molar
    #value = -31.729025639

    #1e+9 in log-molar
    #value = -34.031610732

    #1e+8 in log-molar
    #value = -36.334195825

    #1e+7 in log-molar
    #value = -38.636780918

    #1e+6 in log-molar
    #value = -40.939366011

    execute_on = INITIAL
  []

