    type = FunctionIC
    variable = Dp
    function = 'log(1e20/6.022e23)'
  []
  [em_ic]
    type = FunctionIC
    variable = em
    function = 'log((1e20 + 24e11)/6.022e23)'
  []
  [D_ic]
    type = FunctionIC
    variable = D
    function = 'log(1e16/6.022e23)'
  []
  #[D2_ic]
  #  type = FunctionIC
  #  variable = D2
  #  function = 'log(1e20/6.022e23)'
  #[]
